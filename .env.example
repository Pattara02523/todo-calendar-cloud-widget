# ==============================================================================
# Desktop To-Do & Calendar Cloud Widget — Environment Configuration (.env.example)
# Copy this file to `.env` to override settings locally or configure in Cloud.
# All variables are optional; existing Notion & Google Calendar credentials in
# `notion_config.json` and `.calendar_auth/` continue to work out-of-the-box.
# ==============================================================================

# --- Server Configuration ---
PORT=18234
HOST=127.0.0.1

# Optional API Key to protect mutating endpoints (POST / PUT / PATCH / DELETE /api/*).
# Leave empty to allow unauthenticated local requests (default).
WIDGET_API_KEY=

# --- Notion 2-Way Sync Configuration ---
# Falls back to notion_config.json -> built-in default token if unset.
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# --- Google Calendar OAuth Configuration ---
# Optional inline JSON overrides for cloud deployments (Render / Docker / Heroku).
# Falls back to .calendar_auth/credentials.json and .calendar_auth/gcp-oauth.keys.json.
GOOGLE_CALENDAR_CRED_JSON=
GOOGLE_CALENDAR_KEYS_JSON=

# --- Storage & Test Isolation Overrides ---
# Override paths for local cache and Notion config (used by automated test suites).
TODO_DATA_FILE=
NOTION_CONFIG_FILE=
DISABLE_BACKGROUND_WORKERS=0
